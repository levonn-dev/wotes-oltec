/* Addresses of original game routines and RAM as linker symbols. game_ routines, ram_ work RAM,
   rom_ tables. Each line is a fact about the clean ROM; comments say what, not how it was found. */

game_reset = 0x200;            /* reset handler: TMSS check, hardware init, then the RAM clear */
game_vblank = 0x9E6;           /* level 6 interrupt handler; bumps ram_frame_counter each frame */
game_wait_vblank = 0xBA70;     /* spins until ram_frame_counter changes; d0 preserved */
ram_frame_counter = 0xFF8004;  /* byte, +1 per VBlank */
game_debug_menu = 0x9E0C;      /* the SPECIAL menu: draws its entries, then runs the one chosen */
ram_cheat_menu = 0xFFA94C;     /* word; 0x7F once the pad 1 button code is entered, which adds SPECIAL to camp's OPTIONS */
ram_cheat_debug = 0xFFA94E;    /* word; 0x55 once the pad 2 button code is entered, which adds the four debug entries */
ram_game_level = 0xFF8F3E;     /* byte, 0 to 4: difficulty level the SPECIAL menu's GAME LEVEL steps through */
ram_show_coords = 0xFF8F49;    /* byte; non-zero draws the party coordinates over the map */
ram_monsters_off = 0xFF8F4C;   /* byte; non-zero stops monster spawns and random encounters */
ram_party_x = 0xFF914C;        /* word: party position on the current map, pixels from the west edge */
ram_party_y = 0xFF914E;        /* word: party position on the current map, pixels from the north edge */
ram_region = 0xFF8F3D;         /* byte, 0 to 3: the outdoor region the party stands in - city, valley, jungle, swamp */
ram_region_area = 0xFF8D3E;    /* word: the region the outdoors is showing; the castle-wall swap, the wandering music, the encounter roll and the terrain lookup branch on it */
game_load_region = 0x888;      /* installs the maps, blocks, tile set, animated tiles and music of ram_region; d0 is the packed map x,y to stand on */
game_load_region_tiles = 0xBB90; /* loads the tile set of ram_region; the valley, jungle and swamp branches also store the region in ram_region_area */
game_load_region_animations = 0xC3A; /* copies a region's animated-tile list (count byte, then one type per record at 0xFF8C02) and its graphics block pointer into work RAM; d0 is the list index */
game_load_region_continue = 0x912;      /* inside game_load_region: the jsr to game_load_region_animations that follows the six region-table reads */
game_load_region_place_party = 0x9B8;   /* puts the packed map position d0 into the plane record a0 and resets its width, height, step and fraction fields */
game_load_region_party_pos = 0x988;     /* copies the plane record a0's map position plus 0x60 into ram_party_x, ram_party_y and the other three character records */
game_load_region_after_place = 0x692C;  /* the third helper game_load_region calls after placing the party: one word per follower record, then the second character's position to 0xFFA258 */
game_load_region_tiles_valley = 0xBBB8; /* inside game_load_region_tiles: the valley test and the arms after it, entered with ram_region in d0 */
game_load_region_tiles_jungle = 0xBBCE; /* inside game_load_region_tiles: the jungle arm, graphics set 10 and area id 2 into ram_region_area */
rom_region_table = 0x938;      /* the region maps: six columns of four longs or words, each column indexed by ram_region */
rom_region_animations = 0xB4E; /* five pointers to a region's animated-tile type list, count byte first; game_animate_tiles redraws those tiles every outdoor frame */
rom_region_graphics_block = 0xB82; /* five pointers to each region's graphics block, the source of its tile set and of the frames game_animate_tiles copies; its copy at 0xFF8BFE */
rom_region_names = 0x9D9A;     /* four pointers to the region name strings, "- CITY" through "- SWAMP" */
game_clear_ram = 0x25C;        /* zeroes all 64 KB of work RAM downwards from 0xFFFFFC, before the reset handler reaches 0x300 */
ram_stack_top = 0xFFFF08;      /* lowest byte of 0xFFFC00-0xFFFFFF written during a new game; the stack starts at 0xFFFFF6 and grows down, and 0xFFFFAC is the deepest stack pointer sampled */
ram_map = 0xFFC600;            /* word: which of the 38 dungeon maps is loaded; indexes rom_map_table and both halves of rom_map_directory */
ram_map_entrance = 0xFFC602;   /* word: which of the current map's entry points the party arrived on */
ram_map_pending = 0xFFC6BC;    /* word, meaningful inside a dungeon: 0 stay, positive a rom_dungeon_stairs entry counted from one, negative minus a rom_region_exits index minus one */
game_change_map = 0x11382;     /* loads the dungeon map in the high word of d0 with the entry point in its low word, storing the pair across ram_map and ram_map_entrance */
game_run_dungeon = 0x10BB4;    /* runs a dungeon until the party leaves; d0 is a rom_region_exit_points destination, and the result is what ram_map_pending held */
game_enter_dungeon = 0x103D6;  /* every outdoor frame: if the party stands on a rom_region_exit_points position, runs that dungeon and puts the party where it came out */
game_can_enter_tile = 0x20D50; /* may mover kind d2, object slot d3, step onto dungeon tile d0,d1; a transition object there stores ram_map_pending and refuses */
rom_region_exits = 0x10416;    /* one ram_region byte per outdoor dungeon entrance, 40 entries ended by 0xFF, parallel to rom_region_exit_points */
rom_region_exit_points = 0x104EC; /* 40 struct region_exit: where each outdoor dungeon entrance is and what it opens */
rom_dungeon_stairs = 0x10D0A;  /* 13 struct dungeon_stairs, indexed by ram_map_pending minus one: where a dungeon's staircases lead */
rom_map_table = 0x1145C;       /* 38 struct map_entry: the graphics and wall art of each dungeon map */
rom_map_directory = 0xD5E36;   /* count word, then that many offsets to each map's object list and that many to its text table, all relative to the directory itself */
game_dungeon_clear = 0x110EC;  /* zeroes the dungeon work area 0xFFC600-0xFFF97F and resets ram_text_ring_ptr */
game_dungeon_load_objects = 0x10EEC; /* reads ram_map's object list, text table and entry point from rom_map_directory, then places every object */
game_place_object = 0x111AE;   /* puts one map object record into a free live slot unless its gate flag hides it */
game_spawn_object = 0x20BA8;   /* puts a 16-byte record into a free live slot during play; answers 0 when none is free */
game_automap_mark = 0x11C5E;   /* marks the party's tile and the open tiles in view in ram_automap */
game_automap_draw = 0x116F2;   /* builds the 27 by 26 automap window around the party */
game_automap_screen = 0x1079C; /* camp VIEW MAP underground */
game_name_item_text = 0x2125E; /* writes "<name> FOUND A" or "PICKED UP THE" and an item name into the text ring */
game_char_sprites = 0x6162;    /* rebuilds the four outdoor character sprite buffers of 0x61AA bytes each */
game_monster_near = 0x205C4;   /* sets 0xFFC994 when a monster stands within 3 tiles; always on map 0x11 at entry 0 */
game_load_monster_picture = 0x1F12C; /* copies picture group d1's 60 tiles into corridor buffer d0 */
ram_in_dungeon = 0xFFA93B;     /* byte: set by game_enter_dungeon around game_run_dungeon */
ram_live_objects = 0xFF94B0;   /* 128 slots of 16 bytes: the objects in play */
ram_slot_flags = 0xFFC626;     /* 128 bytes: each live slot's flag byte */
ram_tile_objects = 0xFFC99C;   /* one byte per dungeon tile: the first live slot standing on it */
ram_automap = 0xFFCFDE;        /* one word per dungeon tile: bit 4 seen, the low bits two side classes */
ram_grid = 0xFFE22E;           /* the unpacked grid: width, height, 4, then four side bytes per tile */
ram_text_ring_ptr = 0xFFF774;  /* long: the next write in the text ring at 0xFFF778-0xFFF977 */
ram_monster_pictures = 0xFFDDD6; /* eight pointers to the corridor picture buffers */
rom_monster_pictures = 0xDA068; /* 60-tile picture groups of 0x780 bytes each, from group 1 */
ram_event_flags = 0xFF8F52;    /* 0x20 bytes, one bit per dungeon event: set when the event fires, tested before its object is placed */
game_set_event_flag = 0xDAD4;  /* sets bit d0 of ram_event_flags */
game_test_event_flag = 0xDAF2; /* tests bit d0 of ram_event_flags and answers in the Z flag, not in d0 */
game_party_has_item = 0x21594; /* returns non-zero if any of the four characters carries item d0 */
game_event_object = 0x217A8;   /* runs the map object in slot d0: an item object hands over its item, an event object shows its text and then its gold, damage or quest picture */
game_event_finish = 0x21948;   /* takes the object in slot d0 off the map and sets its ram_event_flags bit */
game_quest_cutscene = 0x213CA; /* plays quest picture d0 and raises ram_game_level to the level that quest unlocks */
game_save_game = 0x99F0;       /* camp SAVE GAME: asks which of the four slots, then copies ram_save_state_start into it */
game_load_game = 0x9AF8;       /* copies save slot d0, 0 to 3, back over ram_save_state_start and re-enters the region the party stood in */
ram_save_state_start = 0xFF8C82; /* first of the 0x702 bytes of work RAM a save slot holds; the last is 0xFF9383 */
game_save_ram_read = 0xB8C2;   /* reads d0 bytes from save-RAM offset a0 (address 0x200005 + 2 * offset) into a1; three tries, carry set if the read never matched */
game_save_ram_write = 0xBA9C;  /* writes d0 bytes from a0 to save-RAM offset a1; three tries, carry set if the write never read back */
game_init_save_ram = 0x995A;   /* when a new game begins: stamps the slot size and, the first time, fills all four slots from ram_save_state_start */
game_check_save_ram = 0xB528;  /* at boot: clears save RAM and stamps rom_save_signature unless the signature is already there */
rom_save_signature = 0xB56E;   /* the eight bytes "WESTWOOD" that open save RAM */
game_draw_outdoor = 0xBB80;        /* redraws both outdoor planes from the region's map data, one call per plane */
game_draw_outdoor_layer = 0xB6BC;  /* builds the whole 64x32 name table of the plane at a0 and sends it in one transfer */
game_draw_outdoor_row = 0xC0F8;    /* rebuilds name table row d0 of the plane at a0 from map row d1 and queues the 64 words */
game_draw_outdoor_column = 0xC218; /* rebuilds name table column d0 of the plane at a0 from map column d1 and queues the 32 words */
game_map_cells_to_tiles = 0xBBEA;  /* writes to a1 the name table words of the tiles running from map tile d0,d1 through the plane at a0 */
game_scroll_outdoor = 0x6DA6;      /* steps both outdoor planes from map position d3 to d4, redrawing the rows and columns that come into view */
game_map_tile_at = 0x741C;         /* the ground tile at map position d0, x in the high word and y in the low; the tile index comes back in d0 and the carry is clear when the tile is blocked */
game_vdp_queue = 0xAB9E;           /* queues one VDP transfer: d0 the destination kind and auto-increment, a0 the source, d1 the VDP address and the word count */
game_vdp_dma = 0xB182;             /* runs the queued transfers from the VBlank handler, writing VDP registers 0x93 to 0x97 for each */
game_vdp_wait = 0xBA80;            /* spins until the transfer queue is empty, then resets it */
game_load_graphics_set = 0x1E90;   /* loads graphics set d0: the chunk list rom_graphics_sets names, to the VRAM address rom_graphics_vram names */
game_load_tiles = 0xB674;          /* sends the chunk list at a0 to VRAM from address a1, expanding first any chunk whose count has bit 15 set */
game_decompress = 0xB5CE;          /* expands the compressed block at a0 into a1 */
game_world_map = 0x97B4;           /* camp VIEW MAP: refuses the jungle and the swamp until their map event flag is set, otherwise draws that region's own map picture with the party marked on it */
game_world_map_refuse = 0x97D8;    /* inside game_world_map: plays a sound, prints YOU DO NOT HAVE A MAP OF THIS AREA YET and returns to the camp menu */
game_terrain_id = 0x12F28;              /* answers in d0 the terrain id the party stands in: its map cell's in rom_terrain_cells in the city and the valley, 0x0B in the jungle, 0x0A anywhere else; the music pickers and the encounter roll index their tables with it */
game_terrain_id_other = 0x12F42;        /* inside game_terrain_id: the arm that answers 0x0A */
rom_terrain_cells = 0xBEB6E;            /* 32 rows of 32 bytes: the terrain id of each 192-pixel map cell, which game_terrain_id answers in the city and the valley */
game_music_wander = 0x4EDC;             /* starts the wandering track of the terrain the party stands in, unless it already plays or ram_music_on is zero */
game_music_combat = 0x505A;             /* starts the combat track of the terrain the party stands in */
game_music_win = 0x509C;                /* starts the win track of the terrain the party stands in */
rom_terrain_wander_tracks = 0x4F80;     /* 14 track numbers indexed by terrain id, played while wandering */
rom_terrain_combat_tracks = 0x508E;     /* 14 track numbers indexed by terrain id, played in a fight */
rom_terrain_win_tracks = 0x50D0;        /* 14 track numbers indexed by terrain id, played when a fight is won */
ram_music_track = 0xFFA91B;             /* byte: the track playing; a picker compares against it before starting another */
ram_music_on = 0xFF8F47;                /* byte; zero silences the three music pickers */
game_encounter_roll = 0x12CD8;          /* from the outdoor loop: counts down to a random encounter, then builds one from the terrain's list and sends it walking at the party */
rom_terrain_encounter_chance = 0x12CB8; /* 14 bytes indexed by terrain id: the roll that decides whether an encounter happens runs 0 to this, and a 0 result means none */
rom_terrain_encounter_groups = 0x12D9C; /* 13 pointers indexed by terrain id to eight struct encounter_entry each; zero for a terrain that has none */
game_encounter_build_group = 0x12F8E;   /* draws up to four entries from the list a0 into ram_encounter_group, within eight monsters and the sprite budget */
rom_encounter_affinity = 0x13018;       /* the masks an entry's affinity byte selects for the first pick of an encounter */
rom_monster_sprite_class = 0x4652;      /* one byte per battle monster from id 0x62: its sprite footprint class */
rom_sprite_class_size = 0x3F756;        /* one word per sprite footprint class; the word over eight is what the battle screen's budget of 0xA3 counts */
ram_encounter_forced = 0xFF8F41;        /* byte; set, the next roll skips its countdown and chance and builds each pick at its most appearing; the roll clears it */
ram_encounter_countdown = 0xFF8CE2;     /* word: rolls left before a random encounter may happen */
ram_encounter_level = 0xFF8F3F;         /* byte from the first pick's level byte; non-zero lets the encounter's monsters use their battle spells */
ram_encounter_group = 0xFF8ED6;         /* pairs of monster id and count for the encounter being built */
ram_encounter_kinds = 0xFF8ED4;         /* word: how many pairs ram_encounter_group holds */
ram_encounter_total = 0xFFA324;         /* word: how many monsters the encounter has; zero while none is running */
rom_encounter_pauses = 0x12C9A;         /* words indexed by ram_game_level: the frames ram_encounter_countdown is reloaded with, 240 at levels 0 and 1, 180 above */
game_encounter_place_next = 0x13140;    /* inside the placement of a group: tries the party's next facing, and gives up once all eight are tried */
game_encounter_place_fail = 0x13152;    /* inside the placement of a group: gives the encounter up */
game_roll_dice = 0xA646;                /* d0 dice of d1 sides plus a0, the sum in d0 */
rom_graphics_sets = 0x1EC6;        /* 18 pointers to chunk lists; a list is count word then source long, ended by a zero count, and bit 15 of a count marks the chunk compressed */
rom_graphics_vram = 0x1EA2;        /* the VRAM address each rom_graphics_sets list loads at, same order */
rom_main_palette = 0x4DA14;        /* the 64 colours every outdoor region and the camp screens fade in to */
ram_map_layer_front = 0xFF8648;    /* struct map_layer of the plane drawn in front of the party, name table 0xC000, fed by the map column of rom_region_table */
ram_map_layer_ground = 0xFF8736;   /* struct map_layer of the ground plane, name table 0xE000, fed by the terrain column of rom_region_table; bit 15 of its map words is the blocked flag */
ram_map_blocks = 0xFF8640;         /* the blocks column of rom_region_table for the region on screen */
ram_map_metatiles = 0xFF8644;      /* the tiles column of rom_region_table for the region on screen */
ram_scroll = 0xFF85B8;             /* four words sent to the VDP every frame: horizontal scroll of the front and ground planes, then the vertical scroll of each */
ram_ground_shadow = 0xFF7000;      /* 64x32 words: the ground plane as drawn, keeping the blocked bit that the VDP copy has stripped */
ram_palette = 0xFF82B6;            /* the 64 colours mirrored to colour RAM */
ram_vdp_queue = 0xFF802C;          /* 64 struct vdp_transfer, a ring the VBlank handler drains */
ram_vdp_queue_read = 0xFF82AC;     /* word: byte offset of the next ram_vdp_queue record to run */
ram_vdp_queue_write = 0xFF82AE;    /* word: byte offset the next queued record is written to */
ram_gfx_buffer = 0xFF0000;         /* scratch the decompressor and the whole-plane redraw build into before the transfer */
rom_special_places = 0xD3E4;       /* 37 struct special_place records ended by a zero word: outdoor rectangles that fire an action once per entry, while ram_game_level is at most the record's level */
rom_special_place_actions = 0xD360; /* 35 bra.w entries, one per special place action index */
rom_speech_index = 0xDBA0;         /* one byte per special place action: word offset of its text in the level's rom_city_speeches table, 0xFF for none */
rom_city_speeches = 0xFAF14;       /* five longs, one text table per game level; a table opens with its own byte size and holds word offsets to its texts */
rom_shop_titles = 0xC55E;          /* four longs to ARMOR SHOP, WEAPON SHOP, MAGIC SHOP, CARAVAN SHOP */
rom_city_npcs = 0xE2FC;            /* 29 struct city_npc records ended by a zero long: the figures drawn on the castle grounds below game level 4 */
rom_townsfolk_spots = 0xE8AC;      /* ten records of a figure byte, a spare byte and a position long; four of the first eight host a wandering townsperson */
rom_fixed_encounters = 0x165A0;    /* three records of region word, position long and data long, ended by a negative word: the one fixed fight each of the valley, swamp and jungle */
rom_graveyard = 0xD7CE;            /* 24 records of position long and text long ended by -1: the castle graveyard's stones; -1 and -3 name a party member */
game_special_places = 0xD30C;      /* every outdoor frame: fires the rom_special_places record the party stands in */
game_city_npcs = 0xE282;           /* every outdoor frame in the city: draws rom_city_npcs and the townsfolk near the view */
game_fixed_encounters = 0x16458;   /* every outdoor frame outside the city: starts the rom_fixed_encounters fight whose position is within 96 pixels of the party */
game_random_range = 0xB5A8;        /* a random number from d0 to d1 inclusive, in d0 */
game_message_box = 0xDEB6;         /* shows the message at a0: a rows byte, an optional control byte below 0x20, NUL-terminated lines, an empty line */
ram_place_latch = 0xFF8F44;        /* byte; set while the party stands in a special place, so its action fires once per entry */
rom_city_figure_tiles = 0xB318E;  /* the first of four tile blocks the city loads over graphics set 0 for its figures: 0xB318E to VRAM 0x75E0, 0xB366E to 0x79A0, 0xB3AEE to 0x7E20, 0xB486E to 0x82A0 */
game_load_city_figures = 0xE1B4;  /* queues the four figure tile blocks when the castle grounds are drawn; the figure records' parameter word 0x2000 puts them on palette line 1 */
game_sprite_record = 0xB05E;      /* builds the hardware sprites of one sprite-list record at a0: position minus the camera a1 plus 128 plus the definition's offsets, palette from the record's parameter word */
rom_item_records = 0x3E58C;       /* 16-byte item records from id 1; byte 1 indexes rom_item_names */
rom_item_names = 0x4FAD2;         /* word offsets from the table's own address to NUL-terminated item names */
rom_monster_names = 0x3D30C;      /* 32 bytes per battle type; the banner reads from type 0x13 */
rom_map_styles = 0x11624;         /* four ten-byte descriptors the map table's style pointers name: the tile count word and compressed source, then the wall art block */
game_draw_dungeon_text = 0x21C32; /* draws a NUL-terminated dungeon text at a0; any byte below 0x20 ends a line, and the ROM uses 0x0D */
game_dungeon_tile_sides = 0x10B54; /* copies dungeon tile d0,d1's sides to 0xFFC6BE rotated so facing d2 comes first, and returns that side in d0 */
game_dungeon_step_check = 0x1036C; /* may the party step from 0xFFC996 facing 0xFFC99A: tests the side of the tile ahead that faces back, carry set when the step happens */
ram_step_side = 0xFFDD72;          /* word: the side value the party's last step tested; 7 plays the door sound */
game_dungeon_secret_door = 0x1065C; /* when the party faces a side of value 8, gives a character of class 6 a one-in-six chance to report the secret door */
game_dungeon_wall_art = 0x10704;   /* draws side value d0's overlay from the map style's wall art block; value 1 is the bare wall and draws none */
game_automap_side = 0x116E4;       /* the automap's class of side value d0: 0 open, 2 for value 7, 1 for every other value */
game_dungeon_battler = 0x120DA;    /* fills the battler record a2 from the dungeon object a0; its battle type is the value byte plus 0x12 */
game_dungeon_monster_name = 0x2145A; /* shows the name of the monster the party faces, from rom_monster_names at the value byte plus 0x12 */
game_event_damage = 0x211BE;       /* event action 0: every living character loses a quarter, rounded up, of a roll from 1 to amount's high nibble times its low nibble */
game_event_reward = 0x2123A;       /* event action 1: adds d0 gold to every character and d1 experience to every living one */
rom_wall_pieces = 0x1028C;         /* 13 words: each wall piece's first word in the strip, then the strip's length */
rom_wall_piece_sizes = 0x102A6;    /* 12 byte pairs: a wall piece's width and height in tiles; a piece's words run row by row */
rom_view_slots = 0x101DE;          /* 17 six-byte view slots: tile offset from the party, side, piece and flags, screen column and row */
rom_view_slots_alt = 0x10244;      /* 12 six-byte view slots of the view drawn halfway through a step */
rom_dungeon_shared_tiles = 0xD53D0; /* 49 packed tiles every dungeon loads after its style's */
game_draw_dungeon_walls = 0x118BE; /* draws every view slot's wall piece from the strip into the view buffers; d0 1 picks rom_view_slots_alt */
game_build_dungeon_view = 0x1111C; /* fills ram_view_sides from the tiles around the party through rom_view_slots */
game_load_view_backdrop = 0x116C2; /* copies wall art entry d0, 176 words, into ram_view_back */
game_load_dungeon_palette = 0x11306; /* copies rom_main_palette to the fade target and the map's graphics block + 0x40 over its line 2 */
ram_tile_records = 0xFFC604;       /* the dungeon's two game_load_tiles records: the style's tiles, then rom_dungeon_shared_tiles */
ram_wall_strip = 0xFFC98C;         /* the current style's bare wall strip */
ram_wall_art = 0xFFDD58;           /* the current style's wall art block */
ram_view_sides = 0xFFDD74;         /* 17 bytes: one side value per view slot */
ram_wall_piece = 0xFFDCAE;         /* the wall piece being drawn, copied from the strip with its overlay applied */
ram_view_front = 0xFFC6CC;         /* 16x11 name table words the wall pieces draw into, sent to VRAM 0xC096 */
ram_view_back = 0xFFC82C;          /* 16x11 name table words of the backdrop and the 0x40-flagged pieces, sent to plane B at 0xE096 */
game_shop = 0xC322;               /* the armor, weapon or magic shop d0 (0 to 2; 3 is the caravan, whose greeting needs a caravan flag): buy and sell screens, then the outdoors redrawn */
rom_shop_stock = 0xCEDE;          /* three longs, one per shop, to 8-byte records: item, a byte that hides the item when negative, least game level, least party level, buy and sell price words; a zero long ends */
rom_shop_greetings = 0xC56E;      /* four longs, one per shop, each to four text longs indexed by ram_game_level */
game_speech = 0xDB2E;             /* shows special place action d0's text for ram_game_level in the message box, page by page on a button, then hides the window */
game_waters_of_life = 0xD942;     /* special place action 32: in the jungle with no encounter walking, the Waters of Life text, a sound, and every character raised and healed */
game_party_restore = 0xE0B8;      /* d0 0 raises the dead and heals everyone, above 0 heals only the living, below 0 only raises the dead; healing also clears the conditions */
game_play_sound = 0x1EF4E;        /* starts sound number d0 through the sound driver; keeps every register */
game_wait_button = 0xE148;        /* runs outdoor frames until A, B, C or START is pressed */
game_outdoor_frame = 0x5DE2;      /* one outdoor frame with nobody moving: sprites, animated tiles, then the wait for VBlank */
game_read_pad = 0xB91C;           /* reads both pads: the low byte of d0 is pad 1's newly pressed buttons, bits 4 to 7 being B, C, A and START */
game_message_box_frame = 0xDF86;  /* draws the message box border for d0 lines into the window plane */
ram_message_box = 0xFFA552;       /* word: lines the message box still has to show, negative once its last page is up; then the long address of its next line */
rom_font_tiles = 0x2341E;         /* graphics set 3: 0x42 tiles of the message font, one per character from 0x20, sent to VRAM tile 0x5B1 */
game_restore_outdoor = 0x8316;    /* after a camp or shop screen: reloads the region's tiles and the font, redraws both planes and the sprites, fades in to rom_main_palette */
game_fade_in = 0xB3BE;            /* waits for the transfer queue, turns the display on and fades all 64 colours of ram_palette in to the palette at a0; callers reach it through the jmp at 0xB3A4 */
game_fade_out = 0xB3AA;           /* fades all 64 colours to black, then turns the display off */
game_fade_to = 0xAEF8;            /* steps d1 colours of ram_palette from colour d0 towards the palette at a0 until they match, a colour RAM transfer each step */
ram_fade_target = 0xFFA4DA;       /* 0x80 bytes: the dungeon's fade-in palette; outdoors, scratch the bridge warning and the graveyard build their message texts in */
game_draw_sprites = 0x6308;       /* empties the sprite list, adds the cursor, then while ram_figures_on is set the city figures and the party */
ram_figures_on = 0xFF8F45;        /* byte; non-zero lets game_draw_sprites call game_city_npcs */
game_sprite_add = 0xAC16;         /* adds a sprite-list record: d0 position, d1 parameter (its halves swapped on store), a0 definition, a1 extra routine or 0; 40 records at most */
ram_sprite_list = 0xFF897A;       /* 40 records of 16 bytes: position, parameter, definition, extra routine */
ram_sprite_count = 0xFF8826;      /* word: records in ram_sprite_list */
game_load_figure_tiles = 0xE222;  /* queues the four city figure tile blocks to VRAM 0x75E0 on and zeroes 0xFF8ED4-0xFF8EFB, the figures' animation and pacer state */
game_npc_stands = 0xE666;         /* figure routine: always drawn; a word of 1 to 3 names an animation slot whose timer swaps the figure's tiles in VRAM, 0 none */
game_npc_paces_x = 0xE6EA;        /* figure routine: always drawn, nudged -1, 0 or +1 pixel east-west by the phase in the ram_npc_pacers byte its word names */
game_npc_paces_y = 0xE752;        /* figure routine: always drawn, nudged -1, 0 or +1 pixel north-south by the phase in the ram_npc_pacers byte its word names */
rom_npc_anim_slots = 0xE6BA;      /* three 16-byte animation slots: least and most frames between swaps, VRAM address and word count, two frame sources */
ram_npc_pacers = 0xFF8EE8;        /* one byte per pacer word: phase 0 to 11 in the high nibble, frames left in the low */
game_townsfolk_place = 0xE7DC;    /* the first pass on the castle grounds: puts four townsfolk on random spots with random paths */
game_townsfolk = 0xE8E8;          /* walks and draws the four townsfolk */
game_monster_sprite_tiles = 0x464A; /* while an encounter walks: gives each monster kind its sprite frames in VRAM from tile 0x319 up */
game_animate_tiles = 0xB96;       /* every outdoor frame: rewrites the region's animated map tiles in VRAM from its graphics block */
game_draw_name_table = 0x1FA4;    /* unpacks the name table at a0, adds 0x3AF to every word and sends it to VRAM address d0 */
rom_panel_layout = 0x4DA94;       /* the packed name table of the window plane: the character panel down the right, drawn from graphics set 0 */
game_special_places_continue = 0xD314;  /* inside game_special_places: the party-y read after the register save, where the walk of rom_special_places starts */
game_city_npcs_level = 0xE288;          /* inside game_city_npcs: the game-level test the city goes on to after the region test */
game_city_npcs_loop = 0xE2C0;           /* inside game_city_npcs: the record loop, entered with d2-d5 and a2 saved, the view box in d2-d5 and the table in a2 */
ram_scene = 0xFF8F3C;                   /* byte; set while a speech shows or the dungeon exit runs, so the outdoor frame draws without moving the party */
ram_party_alive = 0xFF8D42;             /* word: living party members; a speech gives up waiting when it reaches zero */
