/* Addresses of original game routines and RAM as linker symbols. game_ routines, ram_ work RAM,
   rom_ tables. Each line is a fact about the clean ROM; comments say what, not how it was found. */

game_reset = 0x200;            /* reset handler: TMSS check, hardware init, then the RAM clear */
game_vblank = 0x9E6;           /* level 6 interrupt handler; bumps ram_frame_counter each frame */
game_wait_vblank = 0xBA70;     /* spins until ram_frame_counter changes; d0 preserved */
ram_frame_counter = 0xFF8004;  /* byte, +1 per VBlank */
game_debug_menu = 0x9E0C;      /* the SPECIAL menu: draws its entries, then runs the one chosen */
ram_cheat_menu = 0xFFA94C;     /* word; 0x7F once the pad 1 button code is entered, which adds SPECIAL to camp's OPTIONS */
ram_cheat_debug = 0xFFA94E;    /* word; 0x55 once the pad 2 button code is entered, which adds the four debug entries */
ram_game_level = 0xFF8F3E;     /* byte, 0 to 4: difficulty level the SPECIAL menu's GAME LEVEL steps through */
ram_show_coords = 0xFF8F49;    /* byte; non-zero draws the party coordinates over the map */
ram_monsters_off = 0xFF8F4C;   /* byte; non-zero stops monster spawns and random encounters */
ram_party_x = 0xFF914C;        /* word: party position on the current map, pixels from the west edge */
ram_party_y = 0xFF914E;        /* word: party position on the current map, pixels from the north edge */
ram_region = 0xFF8F3D;         /* byte, 0 to 3: the outdoor region the party stands in - city, valley, jungle, swamp */
ram_region_area = 0xFF8D3E;    /* word: the region the outdoors is showing; the castle-wall swap, the wandering music, the encounter roll and the terrain lookup branch on it */
game_load_region = 0x888;      /* installs the maps, blocks, tile set, monsters and music of ram_region; d0 is the packed map x,y to stand on */
game_load_region_tiles = 0xBB90; /* loads the tile set of ram_region; the valley, jungle and swamp branches also store the region in ram_region_area */
game_load_region_monsters = 0xC3A; /* copies a region's monster list and tile base into work RAM; d0 is the list index */
game_load_region_continue = 0x912;      /* inside game_load_region: the jsr to game_load_region_monsters that follows the six region-table reads */
game_load_region_place_party = 0x9B8;   /* puts the packed map position d0 into the plane record a0 and resets its width, height, step and fraction fields */
game_load_region_party_pos = 0x988;     /* copies the plane record a0's map position plus 0x60 into ram_party_x, ram_party_y and the other three character records */
game_load_region_after_place = 0x692C;  /* the third helper game_load_region calls after placing the party: one word per follower record, then the second character's position to 0xFFA258 */
game_load_region_tiles_valley = 0xBBB8; /* inside game_load_region_tiles: the valley test and the arms after it, entered with ram_region in d0 */
game_load_region_tiles_jungle = 0xBBCE; /* inside game_load_region_tiles: the jungle arm, graphics set 10 and area id 2 into ram_region_area */
rom_region_table = 0x938;      /* the region maps: six columns of four longs or words, each column indexed by ram_region */
rom_region_monsters = 0xB4E;   /* five pointers to a region's monster type list, count byte first */
rom_region_tile_base = 0xB82;  /* five pointers to each region's graphics set; its copy at 0xFF8BFE is read only by the monster-sprite loop */
rom_region_names = 0x9D9A;     /* four pointers to the region name strings, "- CITY" through "- SWAMP" */
game_clear_ram = 0x25C;        /* zeroes all 64 KB of work RAM downwards from 0xFFFFFC, before the reset handler reaches 0x300 */
ram_stack_top = 0xFFFF08;      /* lowest byte of 0xFFFC00-0xFFFFFF written during a new game; the stack starts at 0xFFFFF6 and grows down, and 0xFFFFAC is the deepest stack pointer sampled */
ram_map = 0xFFC600;            /* word: which of the 38 dungeon maps is loaded; indexes rom_map_table and both halves of rom_map_directory */
ram_map_entrance = 0xFFC602;   /* word: which of the current map's entry points the party arrived on */
ram_map_pending = 0xFFC6BC;    /* word, meaningful inside a dungeon: 0 stay, positive a rom_dungeon_stairs entry counted from one, negative minus a rom_region_exits index minus one */
game_change_map = 0x11382;     /* loads the dungeon map in the high word of d0 with the entry point in its low word, storing the pair across ram_map and ram_map_entrance */
game_run_dungeon = 0x10BB4;    /* runs a dungeon until the party leaves; d0 is a rom_region_exit_points destination, and the result is what ram_map_pending held */
game_enter_dungeon = 0x103D6;  /* every outdoor frame: if the party stands on a rom_region_exit_points position, runs that dungeon and puts the party where it came out */
game_can_enter_tile = 0x20D50; /* may mover kind d2, object slot d3, step onto dungeon tile d0,d1; a transition object there stores ram_map_pending and refuses */
rom_region_exits = 0x10416;    /* one ram_region byte per outdoor dungeon entrance, 40 entries ended by 0xFF, parallel to rom_region_exit_points */
rom_region_exit_points = 0x104EC; /* 40 struct region_exit: where each outdoor dungeon entrance is and what it opens */
rom_dungeon_stairs = 0x10D0A;  /* 13 struct dungeon_stairs, indexed by ram_map_pending minus one: where a dungeon's staircases lead */
rom_map_table = 0x1145C;       /* 38 struct map_entry: the graphics and wall art of each dungeon map */
rom_map_directory = 0xD5E36;   /* count word, then that many offsets to each map's object list and that many to its text table, all relative to the directory itself */
ram_event_flags = 0xFF8F52;    /* 0x20 bytes, one bit per dungeon event: set when the event fires, tested before its object is placed */
game_set_event_flag = 0xDAD4;  /* sets bit d0 of ram_event_flags */
game_test_event_flag = 0xDAF2; /* tests bit d0 of ram_event_flags and answers in the Z flag, not in d0 */
game_party_has_item = 0x21594; /* returns non-zero if any of the four characters carries item d0 */
game_event_object = 0x217A8;   /* runs the map object in slot d0: an item object hands over its item, an event object shows its text and then its gold, damage or quest picture */
game_event_finish = 0x21948;   /* takes the object in slot d0 off the map and sets its ram_event_flags bit */
game_quest_cutscene = 0x213CA; /* plays quest picture d0 and raises ram_game_level to the level that quest unlocks */
game_save_game = 0x99F0;       /* camp SAVE GAME: asks which of the four slots, then copies ram_save_state_start into it */
game_load_game = 0x9AF8;       /* copies save slot d0, 0 to 3, back over ram_save_state_start and re-enters the region the party stood in */
ram_save_state_start = 0xFF8C82; /* first of the 0x702 bytes of work RAM a save slot holds; the last is 0xFF9383 */
game_save_ram_read = 0xB8C2;   /* reads d0 bytes from save-RAM offset a0 (address 0x200005 + 2 * offset) into a1; three tries, carry set if the read never matched */
game_save_ram_write = 0xBA9C;  /* writes d0 bytes from a0 to save-RAM offset a1; three tries, carry set if the write never read back */
game_init_save_ram = 0x995A;   /* when a new game begins: stamps the slot size and, the first time, fills all four slots from ram_save_state_start */
game_check_save_ram = 0xB528;  /* at boot: clears save RAM and stamps rom_save_signature unless the signature is already there */
rom_save_signature = 0xB56E;   /* the eight bytes "WESTWOOD" that open save RAM */
game_draw_outdoor = 0xBB80;        /* redraws both outdoor planes from the region's map data, one call per plane */
game_draw_outdoor_layer = 0xB6BC;  /* builds the whole 64x32 name table of the plane at a0 and sends it in one transfer */
game_draw_outdoor_row = 0xC0F8;    /* rebuilds name table row d0 of the plane at a0 from map row d1 and queues the 64 words */
game_draw_outdoor_column = 0xC218; /* rebuilds name table column d0 of the plane at a0 from map column d1 and queues the 32 words */
game_map_cells_to_tiles = 0xBBEA;  /* writes to a1 the name table words of the tiles running from map tile d0,d1 through the plane at a0 */
game_scroll_outdoor = 0x6DA6;      /* steps both outdoor planes from map position d3 to d4, redrawing the rows and columns that come into view */
game_map_tile_at = 0x741C;         /* the ground tile at map position d0, x in the high word and y in the low; the tile index comes back in d0 and the carry is clear when the tile is blocked */
game_vdp_queue = 0xAB9E;           /* queues one VDP transfer: d0 the destination kind and auto-increment, a0 the source, d1 the VDP address and the word count */
game_vdp_dma = 0xB182;             /* runs the queued transfers from the VBlank handler, writing VDP registers 0x93 to 0x97 for each */
game_vdp_wait = 0xBA80;            /* spins until the transfer queue is empty, then resets it */
game_load_graphics_set = 0x1E90;   /* loads graphics set d0: the chunk list rom_graphics_sets names, to the VRAM address rom_graphics_vram names */
game_load_tiles = 0xB674;          /* sends the chunk list at a0 to VRAM from address a1, expanding first any chunk whose count has bit 15 set */
game_decompress = 0xB5CE;          /* expands the compressed block at a0 into a1 */
game_world_map = 0x97B4;           /* camp VIEW MAP: refuses the jungle and the swamp until their map event flag is set, otherwise draws that region's own map picture with the party marked on it */
game_world_map_refuse = 0x97D8;    /* inside game_world_map: plays a sound, prints YOU DO NOT HAVE A MAP OF THIS AREA YET and returns to the camp menu */
game_terrain_id = 0x12F28;              /* answers in d0 the terrain id the party stands in: the tile under it in the city and the valley, 0x0B in the jungle, 0x0A anywhere else; the music pickers and the encounter roll index their tables with it */
game_terrain_id_other = 0x12F42;        /* inside game_terrain_id: the arm that answers 0x0A */
game_music_wander = 0x4EDC;             /* starts the wandering track of the terrain the party stands in, unless it already plays or ram_music_on is zero */
game_music_combat = 0x505A;             /* starts the combat track of the terrain the party stands in */
game_music_win = 0x509C;                /* starts the win track of the terrain the party stands in */
rom_terrain_wander_tracks = 0x4F80;     /* 14 track numbers indexed by terrain id, played while wandering */
rom_terrain_combat_tracks = 0x508E;     /* 14 track numbers indexed by terrain id, played in a fight */
rom_terrain_win_tracks = 0x50D0;        /* 14 track numbers indexed by terrain id, played when a fight is won */
ram_music_track = 0xFFA91B;             /* byte: the track playing; a picker compares against it before starting another */
ram_music_on = 0xFF8F47;                /* byte; zero silences the three music pickers */
game_encounter_roll = 0x12CD8;          /* from the outdoor loop: counts down to a random encounter, then builds one from the terrain's list and sends it walking at the party */
rom_terrain_encounter_chance = 0x12CB8; /* 14 bytes indexed by terrain id: the roll that decides whether an encounter happens runs 0 to this, and a 0 result means none */
rom_terrain_encounter_groups = 0x12D9C; /* 13 pointers indexed by terrain id to eight struct encounter_entry each; zero for a terrain that has none */
game_encounter_build_group = 0x12F8E;   /* draws up to four entries from the list a0 into ram_encounter_group, within eight monsters and the sprite budget */
rom_encounter_affinity = 0x13018;       /* the masks an entry's affinity byte selects for the first pick of an encounter */
rom_monster_sprite_class = 0x4652;      /* one byte per battle monster from id 0x62: its sprite footprint class */
rom_sprite_class_size = 0x3F756;        /* one word per sprite footprint class; the word over eight is what the battle screen's budget of 0xA3 counts */
ram_encounter_forced = 0xFF8F41;        /* byte; set, the next roll skips its countdown and chance and builds each pick at its most appearing; the roll clears it */
ram_encounter_countdown = 0xFF8CE2;     /* word: rolls left before a random encounter may happen */
ram_encounter_level = 0xFF8F3F;         /* byte from the first pick's level byte; non-zero lets the encounter's monsters use their battle spells */
ram_encounter_group = 0xFF8ED6;         /* pairs of monster id and count for the encounter being built */
ram_encounter_kinds = 0xFF8ED4;         /* word: how many pairs ram_encounter_group holds */
ram_encounter_total = 0xFFA324;         /* word: how many monsters the encounter has; zero while none is running */
game_roll_dice = 0xA646;                /* d0 dice of d1 sides plus a0, the sum in d0 */
rom_graphics_sets = 0x1EC6;        /* 18 pointers to chunk lists; a list is count word then source long, ended by a zero count, and bit 15 of a count marks the chunk compressed */
rom_graphics_vram = 0x1EA2;        /* the VRAM address each rom_graphics_sets list loads at, same order */
rom_main_palette = 0x4DA14;        /* the 64 colours every outdoor region and the camp screens fade in to */
ram_map_layer_front = 0xFF8648;    /* struct map_layer of the plane drawn in front of the party, name table 0xC000, fed by the map column of rom_region_table */
ram_map_layer_ground = 0xFF8736;   /* struct map_layer of the ground plane, name table 0xE000, fed by the terrain column of rom_region_table; bit 15 of its map words is the blocked flag */
ram_map_blocks = 0xFF8640;         /* the blocks column of rom_region_table for the region on screen */
ram_map_metatiles = 0xFF8644;      /* the tiles column of rom_region_table for the region on screen */
ram_scroll = 0xFF85B8;             /* four words sent to the VDP every frame: horizontal scroll of the front and ground planes, then the vertical scroll of each */
ram_ground_shadow = 0xFF7000;      /* 64x32 words: the ground plane as drawn, keeping the blocked bit that the VDP copy has stripped */
ram_palette = 0xFF82B6;            /* the 64 colours mirrored to colour RAM */
ram_vdp_queue = 0xFF802C;          /* 64 struct vdp_transfer, a ring the VBlank handler drains */
ram_vdp_queue_read = 0xFF82AC;     /* word: byte offset of the next ram_vdp_queue record to run */
ram_vdp_queue_write = 0xFF82AE;    /* word: byte offset the next queued record is written to */
ram_gfx_buffer = 0xFF0000;         /* scratch the decompressor and the whole-plane redraw build into before the transfer */
